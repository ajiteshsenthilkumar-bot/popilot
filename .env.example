# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# AI: one OpenRouter key (openrouter.ai/keys). Only google/ models are used.
OPENROUTER_API_KEY=
# Optional: another google/ model. Default is google/gemini-3.7-flash
# AI_MODEL=google/gemini-3.7-flash

# Google Sheet bridge (see apps-script/Code.gs and the README)
# The web app URL you get after Deploy in Apps Script (ends in /exec)
SHEETS_BRIDGE_URL=
# The secret token shown by running setup() in Apps Script
SHEETS_BRIDGE_TOKEN=
