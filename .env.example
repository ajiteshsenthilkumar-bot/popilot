# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# AI: one OpenRouter key (openrouter.ai/keys). Only google/ models are used.
OPENROUTER_API_KEY=
# Optional: another google/ model. Default is google/gemini-3.7-flash
# AI_MODEL=google/gemini-3.7-flash

# Google Sheet bridge (see apps-script/Code.gs and the README)
# The web app URL you get after Deploy in Apps Script (ends in /exec)
SHEETS_BRIDGE_URL=
# The secret token shown by running setup() in Apps Script
SHEETS_BRIDGE_TOKEN=

# Shopify (read-only stock + sales). Leave empty to use the labelled sample data. See "Shopify" in the README.
# Your store's address, e.g. popilot-test.myshopify.com
SHOPIFY_STORE=
# From your app in the Shopify Dev Dashboard -> Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Daily stock check (runs 09:00 IST via Vercel Cron). Any long random text; Vercel sends it back to prove the call is real.
CRON_SECRET=

# Telegram bot (the quick way to get live messages). See "Live messages: Telegram" in the README.
# From @BotFather when you create the bot. Treat it like a password.
TELEGRAM_BOT_TOKEN=
# Any long random text of letters, numbers, - and _. Telegram sends it back so we know calls are really from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# The ONLY people/groups the bot will read. positive id=Vendor name, positive id=* for YOU (forwarding),
# negative id=Group name. Example: 123456789=*,987654321=Rajesh Labels,-1001234567890=Vendor Group
TELEGRAM_ALLOWED=

# WhatsApp (Meta Cloud API). Paused for now. See "Live WhatsApp" in the README.
# Any long random text you invent. You type the same text into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard -> App settings -> Basic -> App secret. Used to check messages really come from Meta.
WHATSAPP_APP_SECRET=
# Meta WhatsApp -> API setup -> access token. Used to download voice notes.
WHATSAPP_ACCESS_TOKEN=
# The ONLY chats POPilot will read. phone=Vendor name, phone=* for your own number (forwarding), group:ID=Name
# Example: 919812345678=Rajesh Labels,919800000001=Pack Wale,919876500000=*
WHATSAPP_ALLOWED=
