# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# AI: one OpenRouter key (openrouter.ai/keys). Only google/ models are used.
OPENROUTER_API_KEY=
# Optional: another google/ model. Default is google/gemini-3.7-flash
# AI_MODEL=google/gemini-3.7-flash

# Google Sheet bridge (see apps-script/Code.gs and the README)
# The web app URL you get after Deploy in Apps Script (ends in /exec)
SHEETS_BRIDGE_URL=
# The secret token shown by running setup() in Apps Script
SHEETS_BRIDGE_TOKEN=

# WhatsApp (Meta Cloud API). See "Live WhatsApp" in the README.
# Any long random text you invent. You type the same text into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard -> App settings -> Basic -> App secret. Used to check messages really come from Meta.
WHATSAPP_APP_SECRET=
# Meta WhatsApp -> API setup -> access token. Used to download voice notes.
WHATSAPP_ACCESS_TOKEN=
# The ONLY chats POPilot will read. phone=Vendor name, phone=* for your own number (forwarding), group:ID=Name
# Example: 919812345678=Rajesh Labels,919800000001=Pack Wale,919876500000=*
WHATSAPP_ALLOWED=
